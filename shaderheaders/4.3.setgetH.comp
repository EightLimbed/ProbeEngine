// includes setters and getters for geometry
// p is global position vec3, lp is local position v3(0:x) blocks in view
// use local pos for all sampling to keep camera centered within chunks

// not to be used for indexing, just clamps position physically to chunk border
vec3 getChunkPos(vec3 p) {
    return floor(p / chunkSize) * chunkSize;
}

// takes chunk position and spits out index in prefix array

// will handle chunk shuffling, ie getting chunk pos, and matching to actual position, before updating, as well as matching to chunk position
// also need to handle global position offset, ie: chunks player has travelled in each direction.
uvec3 getLocalPos(vec3 p, vec3 worldPos) {
    uvec3 lp = (uvec3(mod(floor(p)+worldPos, full)));
    // wrap lp 
    return lp;
}

// takes position in chunk, and chunk size, and spits out positional index in chunkSize^3 array.
uint posToIndex(uvec3 lp) {
    return lp.x+full*(lp.y+full*lp.z);
}

// sets probe with 8 bit packing
void setProbe(uvec3 lp, float d) {
    uint index = posToIndex(lp);
    uint uintIndex = index >> 2u; // divide by 4 (shift/half twice)
    uint subIndex = index & 3u;
    uint bitShift = subIndex * 8u; // bit shift

    vec4 probes = vec4(0.0);

    probes[subIndex] = (d-dMin) / float(chunkSize); // set distance, normalized to 0-1

    uint packedProbe = packUnorm4x8(probes);
    uint clearMask = ~(0xFFu << bitShift); // clear bit

    atomicAnd(probeData[uintIndex], clearMask);
    atomicOr(probeData[uintIndex], packedProbe); // set value. need clear mask if overwriting
}

// sets material with 4 bit packing
void setMaterial(uvec3 lp, uint m) {
    uint index = posToIndex(lp);
    uint uintIndex = index >> 3u; // divide by 8
    uint bitShift = (index & 7u) * 4u; // bit shift

    uint insert = (m & 0xFu) << bitShift;
    uint clearMask = ~(0xFu << bitShift); // clear bit

    atomicAnd(materialData[uintIndex], clearMask);
    atomicOr(materialData[uintIndex], insert); // set value. need clear mask if overwriting
}

// sets material with 1 bit packing
void setChunkOccupancy(uvec3 lp, uint o) {
    uvec3 ucp = lp/chunkSize; // chunk indexes
    uint index = ucp.x+viewSize*(ucp.y+viewSize*ucp.z);
    uint uintIndex = index >> 5u; // divide by 32
    uint bitShift = (index & 31u); // bit shift 31 bits

    uint insert = (o & 1u) << bitShift;
    uint clearMask = ~(1u << bitShift); // clear bit

    atomicAnd(occupancyData[uintIndex], clearMask);
    atomicOr(occupancyData[uintIndex], insert); // set value. need clear mask if overwriting
}

// gets probe with 8 bit packing
float getProbe(uvec3 lp) {
    uint index = posToIndex(lp);
    uint uintIndex = index >> 2u;
    uint subIndex = index & 3u;

    vec4 values = unpackUnorm4x8(probeData[uintIndex]);

    return ((values[subIndex]*float(chunkSize))+dMin);
}

// gets material with 4 bit packing
uint getMaterial(uvec3 lp) {
    uint index = posToIndex(lp);
    uint uintIndex = index >> 3u;
    uint bitShift = (index & 7u) * 4u; // shift amount

    return (materialData[uintIndex] >> bitShift) & 0xFu;
}

uint getChunkOccupancy(uvec3 lp) {
    uvec3 ucp = lp/chunkSize; // chunk indexes
    uint index = ucp.x+viewSize*(ucp.y+viewSize*ucp.z);

    uint uintIndex = index >> 5u;
    uint bitShift = (index & 31u); // shift amount

    return (occupancyData[uintIndex] >> bitShift) & 0xFu;
}