#version 430 core

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in; // 64 local threads is apparently sweet spot

layout(std430, binding = 0) buffer ProbeData {
    uint probeData[];
};

layout(std430, binding = 1) buffer MaterialData {
    uint materialData[];
};

//const uint chunkSize = 512u;

//include shaders/4.3.constantsH.comp
//include shaders/4.3.functionsH.comp

float sdBox(vec3 p, vec3 b) {
    vec3 d = abs(p) - b;
    return min(max(d.x,max(d.y,d.z)),0.0) + length(max(d,0.0));
}

float smin(float a, float b, float k) {
    float h = max(k-abs(a-b),0.0);
    return min(a, b) - h*h*0.25/k;
}

float smax(float a, float b, float k) {
    float h = max(k-abs(a-b),0.0);
    return max(a, b) + h*h*0.25/k;
}

float sphere(vec3 p, float r) {
    return length(p)-r;
}

// correct way to repeat space every s units
float repeated(vec3 p, float s, float l) {
    vec3 id = round(p/s);
    vec3 o = sign(p-s*id); // neighbor offset direction
    
    float d = 1e20;
    for(int k = 0; k < 2; k++)
    for(int j = 0; j < 2; j++)
    for(int i = 0; i < 2; i++) {
        vec3 rid = id + vec3(i,j,k)*o;
        vec3 r = p - s*rid;
        float rad = hash(rid)*l;
        d = min(d, sphere(r,rad));
    }
    return d;
}

// takes position, layer amplitude, layer amount, spacing, and radius/length of constructor shapes
float terrain(vec3 p, float a, uint layers, float s, float l) {
    float d = p.y; // base/first layer
    for (int i = 0; i < layers; i++) { // noise octaves
        float n = repeated(p, s, l);
        n = smax(n,d-a*s,0.3*s); // smoothly maximize octave a bit above current layer
        d = smin(n,d,0.3*s); // smoothly minimize current latyer with octave
        p *= mat3(0.956,0,0.292,0,1,0,-0.292,0,0.956); // rotate next layer 17 degrees
        s *= 0.5; // reduce spacing and radius of next layer.
        l *= 0.5;
    }
    return d;
}

uint material(vec3 p) {
    return uint(p.y)%6u;
}

// sets probe with 8 bit packing
void setProbe(uvec3 p, float d) {
    uint index = posToIndex(p);
    uint uintIndex = index >> 2u;
    uint subIndex = index & 3u;

    vec4 probes = vec4(0.0);

    probes[subIndex] = (d-dMin) / float(chunkSize); // set distance, normalized to 0-1

    uint packedProbe = packUnorm4x8(probes);

    atomicOr(probeData[uintIndex], packedProbe); // set value. need clear mask if overwriting
}

// sets material with 4 bit packing
void setMaterial(uvec3 p, uint m) {
    uint index = posToIndex(p);
    uint uintIndex = index >> 4u;
    uint bitShift = (index & 7u) * 8u; // bit shift

    uint insert = (m & 0xFFu) << bitShift;

    atomicOr(materialData[uintIndex], insert); // set value. need clear mask if overwriting
}

void main() {
    uvec3 p = gl_GlobalInvocationID;
    //float d = terrain(p+vec3(0.0,192.0,0.0), 0.05, 11, 2560.0, 1280.0);
    float d = terrain(p, 0.05, 10, 160.0, 80.0);
    uint mat = material(p);
    setMaterial(p,mat);
    setProbe(p,d);
}