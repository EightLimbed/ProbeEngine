#version 430 core

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in; // 64 local threads is apparently sweet spot

layout(std430, binding = 0) buffer ProbeData {
    float probeData[];
};
const uint chunkSize = 512u;


//include shaders/4.3.test.head
//include shaders/4.3.test.head
//include shaders/4.3.noiseH.comp
//include shaders/4.3.test.head


// takes position in chunk, and chunk size, and spits out positional index in chunkSize^3 array.
uint posToIndex(uvec3 p) {
    return p.x+chunkSize*(p.y+chunkSize*p.z);
}

float sdBox(vec3 p, vec3 b) {
    vec3 d = abs(p) - b;
    return min(max(d.x,max(d.y,d.z)),0.0) + length(max(d,0.0));
}

float height(vec3 p) {
    float height = ((noise2D(vec2(p.x,p.z)/512.0) + 1.0) * 64.0 + (noise2D(vec2(p.z,p.x)/256.0) + 1.0) * 12.0 + + (noise2D(vec2(p.z,p.x)/24.0) + 1.0) * 6.0);
    return p.y-height;
}

float terrain(vec3 p) {
    return min(
        height(p),
        sdBox(vec3(p-64.0),vec3(12.0,128.0,12.0))
    );
}

void main() {
    uvec3 p = gl_GlobalInvocationID;
    float d = terrain(p);
    probeData[posToIndex(p)]=d;
}