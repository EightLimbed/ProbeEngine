#version 430 core

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in; // 64 local threads is apparently sweet spot

layout(std430, binding = 0) buffer ProbeData {
    float probeData[];
};
//const uint chunkSize = 512u;

//include shaders/4.3.constantsH.comp
//include shaders/4.3.functionsH.comp

float sdBox(vec3 p, vec3 b) {
    vec3 d = abs(p) - b;
    return min(max(d.x,max(d.y,d.z)),0.0) + length(max(d,0.0));
}

float smin(float a, float b, float k) {
    float h = max(k-abs(a-b),0.0);
    return min(a, b) - h*h*0.25/k;
}

float smax(float a, float b, float k) {
    float h = max(k-abs(a-b),0.0);
    return max(a, b) + h*h*0.25/k;
}

float sphere(vec3 p, vec3 id, float r) {
    float rr = hash(id)*r;
    return length(p)-rr;
}

// correct way to repeat space every s units
float repeated2D(vec3 p3, float s, float l) {
    vec2 p = p3.xz;
    vec2 id = round(p/s);
    vec2  o = sign(p-s*id); // neighbor offset direction
    
    float d = 1e20;
    for( int j=0; j<2; j++ )
    for( int i=0; i<2; i++ )
    {
        vec2 rid = id + vec2(i,j)*o;
        vec2 r = p - s*rid;
        d = min(d,sphere(vec3(r.x,p3.y,r.y), vec3(rid.x, 0.0, rid.y), l));
    }
    return d;
}

float terrain(vec3 p, float s, float l) {
    float d = 1e20;
    float ol = l;
    for (int i = 0; i < 8; i++) {
        d = smin(d, repeated2D(p, s, l),0.3*s);
        p.y -= ol-s;
        s*=0.5;
        l*=0.5;
    }
    return d;
}

void main() {
    uvec3 p = gl_GlobalInvocationID;
    float d = terrain(p, 80.0, 80.0);
    probeData[posToIndex(p)]=d;
}