#version 440 core

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in; // 64 local threads is apparently sweet spot

layout(std430, binding = 0) buffer ProbeData {
    uint probeData[];
};

layout(std430, binding = 1) buffer MaterialData {
    uint materialData[];
};

layout(std430, binding = 2) buffer IndexData {
    uint indexData[];
};

uniform uint slot; // slot in buffers to generate at
uniform uint cIndex; // chunk index that stores slot
uniform vec3 cPos;
uniform vec3 uPos; // local to chunk, position of edit

uniform float uSize; // size of edit 
uniform uint uType; // type of edit
uniform uint uMaterial; // material of edit
uniform int uClick; // -1:place or 1:break

//include shaderheaders/4.3.constantsH.comp
//include shaderheaders/4.3.functionsH.comp
//include shaderheaders/4.3.setgetH.comp

// gets edit function at position and size
float getEdit(vec3 p, uint i, float s) {
    switch (i) {
        case 0:
            return sphere(p, s);
        case 1:
            return box(p, vec3(s));
        default:
            return sphere(p, s);
    }
}

void main() {
    uvec3 pp = gl_GlobalInvocationID; // local probe position
    if (clamp(pp, 0, chunkSize-1) != pp) return; // SO IMPORTANT

    // gets index within chunk.
    uint i = pp.x+chunkSize*(pp.y+chunkSize*pp.z);

    // gets global index
    uint index = slot*chunkProbes+i; // index globally

    float nd = getEdit(vec3(pp)+uPos, uType, uSize); // gets new distance
    float od = getProbe(index); // gets current distance

    // sets chunk to index if anything is solid within
    
    // applies edits
    if (uClick == -1) {
        if (nd<od) { // placing
            setMaterial(index,uMaterial);
            setProbe(index,nd);
        }
        updateStoreFlag(min(nd,od));
    } else {
        if (-nd>od) { // breaking
            //setMaterial(lp,uMaterial);
            setProbe(index,-nd);
        }
        updateStoreFlag(max(-nd,od));
    }
}