#version 430 core

layout(local_size_x = 8, local_size_y = 8) in; // 64 local threads is apparently sweet spot

layout(std430, binding = 0) buffer ProbeData {
    uint probeData[];
};

const vec3 colors[10] = {vec3(0.1,0.7,0.1), vec3(0.1,0.8,0.0), vec3(1.0,0.3,0.5), vec3(1.0,0.5,0.1), vec3(0.6,0.3,0.0), vec3(0.5,0.5,0.5), vec3(0.5,0.5,0.1), vec3(0.2,0.8,1.0), vec3(1.0), vec3(0.4,0.6,1.0)};

// player data
uniform vec3 pPos = vec3(0.0,0.0,0.0);
uniform vec3 pDir = vec3(0.0,0.0,1.0);

// screen data
layout(rgba32f, binding=0) uniform writeonly image2D screen;
uniform int screenWidth = 1;
uniform int screenHeight = 1;

//include shaders/4.3.constantsH.comp

// takes position in chunk, and chunk size, and spits out positional index in chunkSize^3 array.
uint posToIndex(ivec3 p) {
    return p.x+chunkSize*(p.y+chunkSize*p.z);
}

// returns a color ID or a distance based on sign
void unpackProbe(uint index, out uint m, out float d) {
    // unpacks value, should think of way to utilize both
    // maybe with morton we get neighboring at once or something
    uint subIndex = index % 4u; // gets subindex within uint
    uint domIndex = (index-subIndex)/4u; // gets uint index
    uint probe = probeData[domIndex]; // gets value 

    float value = unpackSnorm4x8(probe)[subIndex];

    if (value > 0.0) { // set distance
        m = 0u; 
        d = value;
    } else { // set material id
        m = uint(abs(floatBitsToInt(value)));
        d = 0.0;
    }
}

// interpolates between surrounding precomputed probe distances.
void smoothDist(vec3 p, float d, uint m) {
    ivec3 ip = ivec3(floor(p));
    vec3 f = fract(p);
    //vec3 offsetsA[4] = {vec3(0.0,0.0,0.0),vec3(0.0,1.0,0.0),vec3(0.0,0.0,1.0),vec3(0.0,1.0,1.0)};
    //vec3 offsetsB[4] = {vec3(1.0,0.0,0.0),vec3(1.0,1.0,0.0),vec3(1.0,0.0,1.0),vec3(1.0,1.0,1.0)};
    float d000;
    unpackProbe(posToIndex(ip + ivec3(0,0,0)), m, d000);
    float d100;
    unpackProbe(posToIndex(ip + ivec3(1,0,0)), m, d000);
    float d010;
    unpackProbe(posToIndex(ip + ivec3(0,1,0)), m, d000);
    float d110;
    unpackProbe(posToIndex(ip + ivec3(1,1,0)), m, d000);
    float d001;
    unpackProbe(posToIndex(ip + ivec3(0,0,1)), m, d000);
    float d101;
    unpackProbe(posToIndex(ip + ivec3(1,0,1)), m, d000);
    float d011;
    unpackProbe(posToIndex(ip + ivec3(0,1,1)), m, d000);
    float d111;
    unpackProbe(posToIndex(ip + ivec3(1,1,1)), m, d000);

    // x interpolation
    float x00 = mix(d000, d100, f.x);
    float x10 = mix(d010, d110, f.x);
    float x01 = mix(d001, d101, f.x);
    float x11 = mix(d011, d111, f.x);

    // y interpolation
    float y0 = mix(x00, x10, f.y);
    float y1 = mix(x01, x11, f.y);

    // z interpolation
    d = mix(y0, y1, f.z);

    //return d;
}

// camera shizzle
vec3 getRayDir(vec2 fragCoord, vec2 res, vec3 lookAt, float zoom) {
    vec2 uv = (fragCoord - 0.5 * res) / res.y;
    vec3 f = normalize(lookAt);
    vec3 r = normalize(cross(vec3(0.0,1.0,0.0), f));
    vec3 u = cross(f,r);
    return normalize(f + zoom * (uv.x*r + uv.y*u));
}

void main() {
    ivec2 fragCoord = ivec2(gl_GlobalInvocationID.xy);

    float t = 0.0;
    vec3 ro = pPos;
    vec3 rd = getRayDir(fragCoord, vec2(screenWidth,screenHeight),pDir,1.0);
    for (int i = 0; i < raySteps; i++) {
        vec3 p = ro+rd*t;
        //float d = sdBox(p, vec3(4.0));
        float d; 
        uint m;
        smoothDist(p, d, m);
        if (d < e) {
            float falloff = t/1000.0;
            imageStore(screen, fragCoord, mix(vec4(0.1,1.0,0.2,1.0),vec4(0.0,0.4,1.0,1.0),falloff));
            return;
        }
        if (t>renderDist) break;
        t+=max(d,e*10.0);
    }
    imageStore(screen, fragCoord, vec4(0.0,0.4,1.0,1.0));
}
