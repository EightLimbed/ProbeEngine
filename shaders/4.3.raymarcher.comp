#version 440 core

layout(local_size_x = 8, local_size_y = 8) in; // 64 local threads is apparently sweet spot

layout(std430, binding = 0) buffer ProbeData {
    uint probeData[];
};

layout(std430, binding = 1) buffer MaterialData {
    uint materialData[];
};

layout(std430, binding = 2) buffer ChunkData {
    uint chunkData[];
};

layout(std430, binding = 3) buffer ColliderData { // temp for collider view
    uint colliderData[];
};

// player data
uniform vec3 pPos = vec3(0.0,0.0,-1.0);
uniform vec3 worldPos;
uniform vec3 pDir = vec3(0.0,0.0,1.0);

// screen data
layout(rgba32f, binding=0) uniform writeonly image2D colorMap;
layout(rgba32f, binding=1) uniform writeonly image2D depthMap;

uniform int screenWidth = 1;
uniform int screenHeight = 1;
uniform float iTime;

//include shaderheaders/4.3.constantsH.comp
//include shaderheaders/4.3.functionsH.comp
//include shaderheaders/4.3.materialsH.comp
//include shaderheaders/4.3.setgetH.comp
//include shaderheaders/4.3.samplingH.comp

void main() {
    ivec2 fragCoord = ivec2(gl_GlobalInvocationID.xy);

    // crosshair
    vec2 crossHair = fragCoord-vec2(screenWidth,screenHeight)/2.0;
    if (dot(crossHair,crossHair) < 64.0) return;

    // marching
    float t = 0.0;
    vec3 ro = pPos-worldPos+center; // ray pos local to view
    vec3 rd = getRayDir(fragCoord, vec2(screenWidth,screenHeight),pDir,1.0);
    float collect = 0.0;
    for (int i = 0; i < raySteps; i++) {
        if (t*1.1>renderDist) break; // early out

        vec3 p = ro+rd*t; // calculate ray position
        if (clamp(p, vec3(0.0), vec3(chunkSize*viewSize)) != p) break; // borders (temp)

        // distance to chunk border
        //collect += float(chunkData[posToChunkIndex(getLocalPos(p, worldPos))]/chunkProbes)/float(viewChunks*100);
        float cd = distToBorder(mod(p,float(chunkSize)), rd, vec3(chunkSize))+e;
        uint slot = chunkData[posToChunkIndex(getLocalPos(p, worldPos))];
        if (slot == unloaded || getStoreFlag(slot) == generating) { // if in unloaded, skip
            t+=cd+e;
            continue;
        }

        // distance to surface
        float d = getProbeWarped(p);
        if (d<5.0) d = smoothDist(p);

        t+=max(min(d,cd),e); // step ray

        // hit
        if (d < e) { 
            // coloring and stuff
            vec3 normal = getNormal(p);
            float edge = pow(float(i)/float(raySteps),8.0);
            vec4 color = smoothColor(p);//*vec4(max(dot(normal,vec3(1.0)),0.8));

            imageStore(colorMap, fragCoord, mix(color,sky,edge));
            imageStore(depthMap, fragCoord, vec4(normal,t));
            return;
        }
    }
    imageStore(depthMap, fragCoord, vec4(vec3(1.0),renderDist));
    imageStore(colorMap, fragCoord, sky);
}
