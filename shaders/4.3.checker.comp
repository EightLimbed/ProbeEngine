#version 440 core

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in; // 64 local threads is apparently sweet spot

layout(std430, binding = 0) buffer ProbeData {
    uint probeData[];
};

layout(std430, binding = 1) buffer MaterialData {
    uint materialData[];
};

layout(std430, binding = 2) buffer ChunkIDs {
    int chunkIDs[];
};

//include shaderheaders/4.3.constantsH.comp
//include shaderheaders/4.3.functionsH.comp
//include shaderheaders/4.3.setgetH.comp

// parameters
uniform vec3 cPos; // position to check chunk at

// checker can only set to full
// always set the chunk to empty when generating or updating, and have the checker verify that.
// positive index is full, negative is empty
void main() {
    uvec3 pp = gl_GlobalInvocationID; // local chunk position
    if (clamp(pp, 0, chunkSize-1) != pp) return; // SO IMPORTANT

    vec3 p = vec3(pp)+cPos; // global position
    uvec3 lp = getLocalPos(p);

    uvec3 mini = uvec3(getChunkPos(p));
    uvec3 maxi = mini+chunkSize;
    float d = getProbe(lp); // gets distance of probe
    
    if (d<=0.0) chunkIDs[posToChunkIndex(p)] = abs(chunkIDs[posToChunkIndex(p)]); // set to full
}